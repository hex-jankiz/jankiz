# Jankiz Platform - Environment Configuration Example
# ضع توكن البوت الخاص بك من BotFather:
BOT_TOKEN=your_telegram_bot_token_here

# المعرف الرقمي للمسؤول (للوصول إلى أمر /admin):
ADMIN_ID=your_telegram_user_id_here

# منفذ واجهة الويب المحلية:
PORT=5000

# توكن GitHub اختياري لرفع حد الطلبات لـ 5000 طلب/ساعة:
GITHUB_TOKEN=

# الفترة الزمنية بين كل فحص دوري للمصادر (بالدقائق):
NEWS_CHECK_INTERVAL_MINUTES=30
